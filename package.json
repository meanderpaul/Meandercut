{
  "name": "meandercut",
  "productName": "MeanderCut",
  "version": "1.0.0",
  "description": "A focused desktop video editor: timeline editing, clips, audio separation, voice-over recording and 4K export. No stickers, no fluff.",
  "main": "src/main/main.js",
  "author": "Meanderpaul_gaming",
  "license": "MIT",
  "homepage": "https://github.com/meanderpaul/MeanderCut",
  "repository": { "type": "git", "url": "https://github.com/meanderpaul/MeanderCut.git" },
  "keywords": ["video editor", "electron", "ffmpeg", "4k", "voice-over", "capcut alternative"],
  "scripts": {
    "start": "electron .",
    "test": "node test/state.test.mjs && node test/export.test.js",
    "dist": "electron-builder --win",
    "dist:portable": "electron-builder --win portable"
  },
  "dependencies": {
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0"
  },
  "devDependencies": {
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.meanderpaul.meandercut",
    "productName": "MeanderCut",
    "copyright": "Copyright © 2026 Meanderpaul_gaming",
    "files": ["src/**/*", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "fileAssociations": [{ "ext": "mcut", "name": "MeanderCut Project", "role": "Editor" }],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "directories": { "output": "dist" }
  }
}
